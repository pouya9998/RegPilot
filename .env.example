APP_ENV=production
APP_PORT=8080
# Host port mapping (change if 8080 is already in use)
HOST_PORT=8080

DATABASE_PATH=/data/regpilot.db

JWT_SECRET=change-this-secret
JWT_EXPIRATION=24h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

ENCRYPTION_KEY=change-me-to-32-bytes-secret!!

CORS_ALLOWED_ORIGINS=http://localhost:8080

ENABLE_SWAGGER=true

# Optional: local registry GC (container name on the Docker host)
REGISTRY_CONTAINER_NAME=
REGISTRY_GC_MODE=local

# Rate limiting
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
